# Database Configuration (Neon Postgres via Prisma)
# Use the pooled ("-pooler") connection string from the Neon console.
# Note: the Prisma CLI (npm run db:push / db:studio) reads .env, not .env.local;
# `npx tsx lib/init-db.ts` loads .env.local for you.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Gemini/Google Vertex LLM API Key
GEMINI_API_KEY=your-gemini-api-key
# Alternative: GOOGLE_VERTEX_API_KEY=your-vertex-api-key

# Auth configuration & security keys
AUTH_SECRET=generate-a-secure-random-string
ENCRYPTION_KEY=32-character-encryption-key-for-AES

# OAuth Provider details (Required for NextAuth login flow)
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# Production configurations (Optional)
# EVE_NEXT_PRODUCTION_ORIGIN=https://rhea-agent.prod.internal
# EVE_NEXT_PRODUCTION_PORT=4274

# Local dev login bypass. OFF by default; opt in ONLY on your own machine
# against a local DB. Ignored when NODE_ENV=production. Only AUTH_DEV_EMAIL
# can sign in this way (defaults to dev@local.test).
AUTH_DEV_BYPASS=false
NEXT_PUBLIC_AUTH_DEV_BYPASS=false
# AUTH_DEV_EMAIL=dev@local.test

# LLM (optional for boot; set one to run the agent)
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-5
