// Rhea database schema (Neon Postgres via Prisma).
//
// Table and column names are mapped 1:1 to the original DDL (lib/init-db.ts on
// the DSQL branch) so that all existing raw SQL call sites keep working.
// Apply with: npm run db:push   (or: npx tsx lib/init-db.ts)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Core tables ──

model Organization {
  orgId     String    @id @default(dbgenerated("gen_random_uuid()")) @map("org_id") @db.Uuid
  name      String    @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("organizations")
}

// ── Auth & multi-tenancy tables ──

model User {
  userId            String    @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  email             String    @unique @db.VarChar(255)
  name              String?   @db.VarChar(255)
  role              String?   @default("VIEWER") @db.VarChar(50)
  avatarUrl         String?   @map("avatar_url")
  provider          String?   @db.VarChar(50)
  providerAccountId String?   @map("provider_account_id") @db.VarChar(255)
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  lastLogin         DateTime? @map("last_login") @db.Timestamp(6)

  @@map("users")
}

model ApiKey {
  keyId     String    @id @default(dbgenerated("gen_random_uuid()")) @map("key_id") @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  createdBy String?   @map("created_by") @db.Uuid
  keyHash   String    @map("key_hash") @db.VarChar(64)
  keyPrefix String    @map("key_prefix") @db.VarChar(8)
  label     String?   @db.VarChar(255)
  scopes    Json?
  expiresAt DateTime? @map("expires_at") @db.Timestamp(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamp(6)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("api_keys")
}

model OrgSettings {
  orgId     String    @id @map("org_id") @db.Uuid
  settings  Json?     @default("{}")
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("org_settings")
}

// ── Incident & investigation tables (tenant-scoped) ──

model Incident {
  incidentId        String    @id @default(dbgenerated("gen_random_uuid()")) @map("incident_id") @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  title             String    @db.VarChar(255)
  description       String?
  severity          String?   @db.VarChar(50)
  status            String?   @default("ACTIVE") @db.VarChar(50)
  agentSessionState Json?     @map("agent_session_state")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamp(6)

  @@map("incidents")
}

model Investigation {
  investigationId String    @id @default(dbgenerated("gen_random_uuid()")) @map("investigation_id") @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  incidentId      String    @map("incident_id") @db.Uuid
  rankedCauses    Json?     @map("ranked_causes")
  findings        String?
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("investigations")
}

model RootCause {
  causeId         String    @id @default(dbgenerated("gen_random_uuid()")) @map("cause_id") @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  investigationId String    @map("investigation_id") @db.Uuid
  category        String?   @db.VarChar(100)
  description     String?
  confidence      Float?
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("root_causes")
}

model FixPattern {
  patternId           String    @id @default(dbgenerated("gen_random_uuid()")) @map("pattern_id") @db.Uuid
  orgId               String    @map("org_id") @db.Uuid
  causeCategory       String?   @map("cause_category") @db.VarChar(100)
  remediationTemplate String?   @map("remediation_template")
  successRate         Float?    @map("success_rate")
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("fix_patterns")
}

model ConnectorInstance {
  instanceId        String    @id @default(dbgenerated("gen_random_uuid()")) @map("instance_id") @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  connectorType     String    @map("connector_type") @db.VarChar(100)
  displayName       String    @map("display_name") @db.VarChar(255)
  mcpUrl            String    @map("mcp_url")
  connectProviderId String    @map("connect_provider_id") @db.VarChar(100)
  connectedBy       String?   @map("connected_by") @db.Uuid
  status            String?   @default("ACTIVE") @db.VarChar(50)
  lastHealthCheck   DateTime? @map("last_health_check") @db.Timestamp(6)
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  connectedAt       DateTime? @map("connected_at") @db.Timestamp(6)

  @@map("connector_instances")
}

model SandboxSession {
  sessionId      String    @id @map("session_id") @db.VarChar(255)
  orgId          String    @map("org_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  status         String?   @default("ACTIVE") @db.VarChar(50)
  allowedDomains Json?     @default("[]") @map("allowed_domains")
  configLimits   Json?     @default("{}") @map("config_limits")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("sandbox_sessions")
}

model SandboxExecution {
  executionId     String    @id @default(dbgenerated("gen_random_uuid()")) @map("execution_id") @db.Uuid
  sessionId       String    @map("session_id") @db.VarChar(255)
  command         String
  status          String    @db.VarChar(50)
  exitCode        Int?      @map("exit_code")
  stdout          String?
  stderr          String?
  executionTimeMs Int?      @map("execution_time_ms")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("sandbox_executions")
}

model AgentChat {
  chatId            String    @id @default(dbgenerated("gen_random_uuid()")) @map("chat_id") @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  title             String    @default("New Chat") @db.VarChar(255)
  agentSessionState Json?     @map("agent_session_state")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("agent_chats")
}

// ── Agent hook event log (replaces the DynamoDB Sessions / Executions /
//    ToolCalls / AgentTasks tables). `data` holds the full item document. ──

model HookSession {
  sessionId String   @id @map("session_id")
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("hook_sessions")
}

model HookExecution {
  executionId String   @id @map("execution_id")
  data        Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("hook_executions")
}

model HookToolCall {
  callId    String   @id @map("call_id")
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("hook_tool_calls")
}

model HookAgentTask {
  taskId    String   @id @map("task_id")
  data      Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("hook_agent_tasks")
}

// ── Platform tables (rhea: Role / Assignment / Task / UsageLedger) ──
// See docs/naming-and-concepts.md for the product <-> engineering vocabulary.

model Role {
  roleId      String    @id @default(dbgenerated("gen_random_uuid()")) @map("role_id") @db.Uuid
  roleKey     String    @unique @map("role_key") @db.VarChar(100)
  name        String    @db.VarChar(255)
  description String?
  manifest    Json
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("roles")
}

model Assignment {
  assignmentId String    @id @default(dbgenerated("gen_random_uuid()")) @map("assignment_id") @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  roleKey      String    @map("role_key") @db.VarChar(100)
  name         String    @db.VarChar(255)
  config       Json
  secretsEnc   String?   @map("secrets_enc")
  status       String    @default("active") @db.VarChar(50)
  createdBy    String?   @map("created_by") @db.Uuid
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  @@index([orgId])
  @@map("assignments")
}

model Task {
  taskId       String    @id @default(dbgenerated("gen_random_uuid()")) @map("task_id") @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  assignmentId String    @map("assignment_id") @db.Uuid
  status       String    @default("requested") @db.VarChar(50)
  request      String
  sessionId    String?   @map("session_id")
  branch       String?
  previewUrl   String?   @map("preview_url")
  prUrl        String?   @map("pr_url")
  publishedUrl String?   @map("published_url")
  error        String?
  plan         Json?     @map("plan")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  @@index([orgId, assignmentId])
  @@map("tasks")
}

model UsageLedger {
  usageId          String    @id @default(dbgenerated("gen_random_uuid()")) @map("usage_id") @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  assignmentId     String?   @map("assignment_id") @db.Uuid
  taskId           String?   @map("task_id") @db.Uuid
  roleKey          String    @map("role_key") @db.VarChar(100)
  tool             String    @db.VarChar(100)
  provider         String    @db.VarChar(50)
  model            String    @db.VarChar(100)
  inputTokens      Int       @map("input_tokens")
  outputTokens     Int       @map("output_tokens")
  cacheReadTokens  Int       @map("cache_read_tokens")
  cacheWriteTokens Int       @map("cache_write_tokens")
  costUsd          Decimal   @map("cost_usd") @db.Decimal(12, 6)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([orgId, createdAt])
  @@map("usage_ledger")
}
